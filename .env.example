# FastAPI connects to Qdrant over the Docker Compose network.
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_SCHEME=http
QDRANT_TIMEOUT_SECONDS=10

# PostgreSQL connection pool limits per worker. Timeout is in seconds.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=rag
POSTGRES_PASSWORD=change-me
POSTGRES_DATABASE=rag
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=0
POSTGRES_POOL_TIMEOUT=30

# Qdrant HTTP connection pool limits per worker. Expiry is in seconds.
QDRANT_MAX_CONNECTIONS=100
QDRANT_MAX_KEEPALIVE_CONNECTIONS=20
QDRANT_KEEPALIVE_EXPIRY_SECONDS=5
QDRANT_COLLECTION_NAME=pdf_chunks_minilm_l6_v2
QDRANT_BATCH_SIZE=64

# Use a new collection when changing the embedding model.
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_VECTOR_SIZE=384
EMBEDDING_BATCH_SIZE=32

# MinIO: endpoint has no URL scheme; MINIO_SECURE controls TLS.
# Defaults below are for local development only.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_NAME=processed-pdfs
MINIO_REGION=us-east-1
MINIO_TIMEOUT_SECONDS=30
