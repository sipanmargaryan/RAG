#!/usr/bin/env python3

import re
import sys
from pathlib import Path

RED = "\033[31m"
GREEN = "\033[32m"
RESET = "\033[0m"


def error(message):
    print(f"{RED}Error: {message}{RESET}")


if len(sys.argv) < 2:
    error("commit message file not provided.")
    sys.exit(1)

message_file = Path(sys.argv[1])
lines = message_file.read_text().splitlines()
message = lines[0].strip() if lines else ""

pattern = r"^(feat|fix|docs|refactor|test|chore): .+"
ticket_pattern = r"\bJIRA-\d+\b"

if not re.match(pattern, message):
    error("use type: description")
    print(f"Example: feat: add login JIRA-123")
    sys.exit(1)

if not re.search(ticket_pattern, message):
    error("commit message must contain a ticket number.")
    print("Example: feat: add login JIRA-123")
    sys.exit(1)

print(f"{GREEN}Commit message validated.{RESET}")
sys.exit(0)
